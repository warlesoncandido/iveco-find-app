{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "iveco-find-app-mobile",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define=BASE_URL=http://10.0.2.2:3000",
                // URL do QR Code: troque pelo IP desta máquina na rede local (celulares precisam alcançá-lo).
                "--dart-define=PUBLIC_URL=http://192.168.1.80:3000"
            ]
        },
        {
            "name": "iveco-find-app-desktop",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define=BASE_URL=http://localhost:3000",
                // URL do QR Code: troque pelo IP desta máquina na rede local (celulares precisam alcançá-lo).
                "--dart-define=PUBLIC_URL=http://192.168.1.80:3000"
            ]
        },
        {
            "name": "iveco-find-app (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "iveco-find-app (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}